# Neon Postgres — added automatically when you connect Neon via Vercel → Storage
DATABASE_URL=

# Vercel AI Gateway — automatic on Vercel (OIDC). Locally, create a key in Vercel → AI Gateway.
AI_GATEWAY_API_KEY=
# Optional model override
AGENT_MODEL=anthropic/claude-sonnet-4.5

# Telegram designer handoff (optional — without these, handoffs are stored but marked SIMULATED)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret path segment checked on the Telegram webhook
TELEGRAM_WEBHOOK_SECRET=

# Calendly — consultation booking
# Your public event link, e.g. https://calendly.com/aangan-studio/free-consultation
CALENDLY_EVENT_URL=
# Signing key returned when you create the webhook subscription (Standard plan or above)
CALENDLY_WEBHOOK_SIGNING_KEY=

# Vaani AI — path secret for the post-call webhook (Settings → Webhooks → https://<app>/api/vaani/webhook/<secret>)
VAANI_WEBHOOK_SECRET=
